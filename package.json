{
  "name": "smip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": { "types": "./dist/mcp/server.d.ts", "import": "./dist/mcp/server.js" }
  },
  "bin": { "smip": "./dist/cli/main.js" },
  "files": [
    "dist",
    "libexec",
    "ThirdPartyLicenses",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc && node scripts/build-resources.mjs dist",
    "test": "npm run build && tsc -p tsconfig.test.json && node scripts/build-resources.mjs dist-test/src && node --test dist-test/test/*.test.js",
    "test:integration": "npm test",
    "build:native": "node scripts/build-native.mjs build --configuration release",
    "test:native": "node scripts/build-native.mjs test",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "package:local": "node scripts/package-local.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-codemode": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@modelcontextprotocol/server": "2.3.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "22.19.19",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
