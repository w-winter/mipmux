{
  "name": "mipmux",
  "version": "0.1.0-alpha.2",
  "description": "Headless port of RepoPrompt CE's Context Builder: an MCP server that builds verified context packets for coding agents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w-winter/mipmux.git"
  },
  "homepage": "https://github.com/w-winter/mipmux#readme",
  "bugs": "https://github.com/w-winter/mipmux/issues",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": { "types": "./dist/mcp/server.d.ts", "import": "./dist/mcp/server.js" }
  },
  "bin": { "mipmux": "./dist/cli/main.js" },
  "imports": { "#mipmux-native/*": "./libexec/*/MipmuxBridge" },
  "files": [
    "dist",
    "libexec",
    "ThirdPartyLicenses",
    "THIRD_PARTY_NOTICES.md",
    "package-lock.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc --singleThreaded && node scripts/build-resources.mjs dist",
    "test": "npm run build && tsc -p tsconfig.test.json && node scripts/build-resources.mjs dist-test/src && node --test dist-test/test/*.test.js",
    "test:integration": "npm test",
    "build:native": "node scripts/build-native.mjs build --configuration release",
    "test:native": "node scripts/build-native.mjs test",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "package:local": "node scripts/package-local.mjs",
    "package:release": "node scripts/package-release.mjs",
    "package:npm": "node scripts/package-npm.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@modelcontextprotocol/server": "2.3.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "22.19.19",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
