{
  "name": "omp-mipmux",
  "version": "0.1.0",
  "description": "oh-my-pi extension that selects a saved mipmux workspace and applies build preferences to mipmux calls",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/w-winter/mipmux.git", "directory": "integrations/omp" },
  "homepage": "https://github.com/w-winter/mipmux/tree/main/integrations/omp#readme",
  "bugs": "https://github.com/w-winter/mipmux/issues",
  "type": "module",
  "private": true,
  "files": ["src"],
  "omp": { "extensions": ["./src/extension.ts"] },
  "imports": { "#typebox": "typebox" },
  "dependencies": {
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": { "optional": true },
    "@oh-my-pi/pi-tui": { "optional": true }
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.13.0",
    "@oh-my-pi/pi-tui": "18.13.0"
  },
  "scripts": {
    "typecheck": "node scripts/copy-shared.mjs && tsc -p tsconfig.json",
    "test": "node scripts/copy-shared.mjs && bun test",
    "release": "node scripts/staged-npm.mjs publish"
  }
}
